# Public Supabase project values. The publishable key is safe for the browser;
# authorization is enforced by PostgreSQL Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional compatibility for projects still using legacy anon keys.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Development only. Never enable this in a deployed environment.
NEXT_PUBLIC_WWT_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Phase 3 unified inbox. Everything below is SERVER-ONLY. Never prefix any of
# these with NEXT_PUBLIC_ and never commit real values.
# ---------------------------------------------------------------------------

# Supabase service-role (or sb_secret_) key. Used only by the signed channel
# webhook to store inbound messages; ordinary CRM requests never use it.
SUPABASE_SERVICE_ROLE_KEY=

# Meta app (developers.facebook.com → your app → App settings → Basic).
META_APP_SECRET=
# Any long random string you choose; enter the same value in Meta's webhook setup.
META_WEBHOOK_VERIFY_TOKEN=
# Optional. Defaults to v23.0.
# META_GRAPH_API_VERSION=v23.0

# WhatsApp Business Platform (Cloud API).
# Permanent System User token with whatsapp_business_messaging and
# whatsapp_business_management permissions.
WHATSAPP_ACCESS_TOKEN=
# WhatsApp Business Account ID. Lets Settings list and register your numbers.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Facebook Messenger and Instagram (prepared; enable after Meta App Review).
# MESSENGER_PAGE_ACCESS_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_GRAPH_HOST=graph.facebook.com

# Optional AI assistance in the Inbox (summaries, reply drafts, extraction).
# Drafts always require an employee to review and send them.
# ANTHROPIC_API_KEY=
# INBOX_AI_MODEL=claude-opus-5-5
