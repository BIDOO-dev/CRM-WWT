# Public Supabase project values. The publishable key is safe for the browser;
# authorization is enforced by PostgreSQL Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional compatibility for projects still using legacy anon keys.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Development only. Never enable this in a deployed environment.
NEXT_PUBLIC_WWT_DEMO_MODE=false
